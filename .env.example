# ==========================================================
# PLAYBOOK DE VENDAS QUEST — VARIÁVEIS DE AMBIENTE (.env)
# ==========================================================

# Ambiente (development | test | production)
NODE_ENV=production

# Domínio e Subpath Oficial em Produção (VPS)
FRONTEND_URL=https://questos.com.br/comercial
BASE_PATH=/comercial
API_PREFIX=/api/v1
VITE_BASE_PATH=/comercial/
VITE_API_URL=/comercial/api/v1
FRONTEND_PORT=8080

# Servidor Backend
PORT=3001

# Banco de Dados PostgreSQL (Docker Compose)
POSTGRES_USER=quest_user
POSTGRES_PASSWORD=DefinaUmaSenhaFortePostgresQuest2026
POSTGRES_DB=playbook_quest
DATABASE_URL="postgresql://quest_user:DefinaUmaSenhaFortePostgresQuest2026@postgres:5432/playbook_quest?schema=public"
USE_EMBEDDED_PG=false
PGDATA_DIR=./data/pgdata

# Segurança e Sessões (Cookies HttpOnly — mínimo 32 caracteres em produção)
SESSION_COOKIE_NAME=quest_playbook_sid
SESSION_TTL_HOURS=24
SESSION_SECRET=defina_uma_chave_aleatoria_com_pelo_menos_64_caracteres_hexadecimais_aqui

# Recuperação e Ativação de Senha
PASSWORD_RESET_TTL_MINUTES=60

# Inteligência Artificial — Assistente Comercial Quest (Somente Backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS_PER_RESPONSE=1200
AI_DAILY_TOKEN_LIMIT_PER_USER=50000

# Integrações e Webhooks (n8n / Radar Quest — mínimo 24 caracteres em produção)
WEBHOOK_SHARED_SECRET=defina_um_segredo_hmac_exclusivo_para_webhooks_n8n_radar_quest

# E-mail transacional (Recuperação de senha e convites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Playbook Quest <no-reply@questcomunicacao.com.br>"
