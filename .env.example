# ==========================================================
# PLAYBOOK DE VENDAS QUEST — VARIÁVEIS DE AMBIENTE (.env)
# ==========================================================

# Ambiente (development | test | production)
NODE_ENV=development

# Servidor Backend
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Banco de Dados PostgreSQL
# Em produção / Docker Compose (Coolify / VPS Hostinger):
DATABASE_URL="postgresql://quest_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/playbook_quest?schema=public"
# Para desenvolvimento local sem Docker ativo, o sistema ativa automaticamente o motor PostgreSQL 16 embarcado (PGlite) persistido em ./backend/data/pgdata se o servidor PostgreSQL externo não estiver acessível, ou quando USE_EMBEDDED_PG=true:
USE_EMBEDDED_PG=auto
PGDATA_DIR=./data/pgdata

# Segurança e Sessões (Cookies HttpOnly)
SESSION_COOKIE_NAME=quest_playbook_sid
SESSION_TTL_HOURS=24
SESSION_SECRET=replace_with_at_least_64_random_hex_characters_in_production

# Recuperação e Ativação de Senha
PASSWORD_RESET_TTL_MINUTES=60

# Inteligência Artificial — Assistente Comercial Quest (Somente Backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS_PER_RESPONSE=1200
AI_DAILY_TOKEN_LIMIT_PER_USER=50000

# Integrações e Webhooks (n8n / Radar Quest)
WEBHOOK_SHARED_SECRET=replace_with_webhook_hmac_secret_in_production

# E-mail transacional (Recuperação de senha e convites)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Playbook Quest <no-reply@questcomunicacao.com.br>"

